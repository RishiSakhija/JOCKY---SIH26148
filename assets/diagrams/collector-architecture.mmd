flowchart TD
    subgraph RUNTIME["JOCKY Runtime"]
        DISPATCH["Dispatcher\n(execute step)"]
        CTX["ExecutionContext\nrun_id, evidence_root, target, temp_dir"]
    end

    subgraph REGISTRY["Collector Registry"]
        REG["Registry\n(name → Collector trait object)"]
        MANIFEST["Collector Manifests\ncapabilities, schemas, versions"]
    end

    subgraph TRAIT["Collector Trait (jockey-collectors)"]
        TRAIT_DEF["trait Collector\nname(), version()\nsupported_actions()\nsupported_os()\nexecute()"]
    end

    subgraph WINDOWS["Windows Collectors (windows-sys)"]
        PROC_W["proc_windows\nlist, get, tree\n→ artifact/process"]
        FILE_W["file_windows\nenumerate, hash, collect, mft, usn, vss\n→ artifact/file, artifact/ntfs, artifact/mft"]
        REG_W["registry_windows\nenumerate, get, monitor\n→ artifact/reg"]
        LOGS_W["logs_windows\nquery, export, tail\n→ artifact/evt"]
        NET_W["net_windows\nconnections, listen, capture\n→ artifact/connection"]
    end

    subgraph LINUX["Linux Collectors (userspace)"]
        PROC_L["proc_linux\nlist, get, tree\n/proc, auditd\n→ artifact/process"]
        FILE_L["file_linux\nenumerate, hash, collect, fanotify\n→ artifact/file"]
        CONFIG_L["config_linux\nenumerate, get, systemd, journald\n→ artifact/config, artifact/journald"]
        LOGS_L["logs_linux\nquery, export, audit\n→ artifact/syslog, artifact/audit"]
        NET_L["net_linux\nconnections, listen, capture, conntrack\n→ artifact/connection"]
    end

    subgraph EBPF["eBPF Extensions (Future, Aya)"]
        PROC_E["proc_ebpf\nexec/fork/exit trace"]
        FILE_E["file_ebpf\nopen/read/write/unlink trace"]
        NET_E["net_ebpf\nconnect/accept/send/recv trace"]
        CRED_E["cred_ebpf\ncredential access trace"]
    end

    subgraph OUTPUT["Output"]
        EVIDENCE["Evidence Objects\n(id, type, hash, metadata)"]
        RECEIPT["Evidence Receipts\n(Ed25519, blake3)"]
        PROVENANCE["Provenance Records\n(hash-linked chain)"]
    end

    DISPATCH --> REG
    REG --> TRAIT_DEF
    TRAIT_DEF --> PROC_W
    TRAIT_DEF --> FILE_W
    TRAIT_DEF --> REG_W
    TRAIT_DEF --> LOGS_W
    TRAIT_DEF --> NET_W
    TRAIT_DEF --> PROC_L
    TRAIT_DEF --> FILE_L
    TRAIT_DEF --> CONFIG_L
    TRAIT_DEF --> LOGS_L
    TRAIT_DEF --> NET_L
    TRAIT_DEF -.-> PROC_E
    TRAIT_DEF -.-> FILE_E
    TRAIT_DEF -.-> NET_E
    TRAIT_DEF -.-> CRED_E

    PROC_W --> EVIDENCE
    FILE_W --> EVIDENCE
    REG_W --> EVIDENCE
    LOGS_W --> EVIDENCE
    NET_W --> EVIDENCE
    PROC_L --> EVIDENCE
    FILE_L --> EVIDENCE
    CONFIG_L --> EVIDENCE
    LOGS_L --> EVIDENCE
    NET_L --> EVIDENCE
    PROC_E -.-> EVIDENCE
    FILE_E -.-> EVIDENCE
    NET_E -.-> EVIDENCE
    CRED_E -.-> EVIDENCE

    EVIDENCE --> RECEIPT
    RECEIPT --> PROVENANCE

    CTX --> DISPATCH
    MANIFEST --> REG

