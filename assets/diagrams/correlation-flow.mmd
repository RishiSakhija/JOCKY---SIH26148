        C4["CorrelationEdge\nsrc=E4, dst=E5\nrelation='resolved_to'\nconfidence=1.0\nmethod='ioc_match'\nevidence_ids=[E4.id, E5.id]"]
    end

    subgraph GRAPH["Investigation Graph (petgraph)"]
