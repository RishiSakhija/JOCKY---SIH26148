    subgraph RULES["Correlation Rules Engine"]
        R1["Rule: pid_link\nrelation='spawned'\nsource=artifact/process\ntarget=artifact/process\ncondition: source.pid == target.ppid\nconfidence=1.0"]
        R2["Rule: file_write\nrelation='wrote'\nsource=artifact/process\ntarget=artifact/file\ncondition: process.pid == file.writer_pid\nconfidence=0.95"]
        R3["Rule: net_link\nrelation='connected'\nsource=artifact/process\ntarget=artifact/connection\ncondition: process.pid == conn.pid\nconfidence=0.95"]
        R4["Rule: ioc_match\nrelation='resolved_to'\nsource=artifact/connection\ntarget=indicator/ioc\ncondition: conn.remote_ip in indicator.ips\nconfidence=1.0"]
        R5["Rule: timestamp_join\nrelation='timeline_adjacent'\nsource=*\ntarget=*\ncondition: |t1 - t2| <= window\nconfidence=0.7"]
    end

    subgraph EDGES["Correlation Edges"]
        C1["CorrelationEdge\nsrc=E1, dst=E2\nrelation='spawned'\nconfidence=1.0\nmethod='pid_link'\nevidence_ids=[E1.id, E2.id]"]
        C2["CorrelationEdge\nsrc=E2, dst=E3\nrelation='wrote'\nconfidence=0.95\nmethod='file_write'\nevidence_ids=[E2.id, E3.id]"]
