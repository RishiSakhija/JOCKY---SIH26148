erDiagram
    INVESTIGATION ||--o{ EXECUTION_CONTRACT : has
    INVESTIGATION ||--o{ EVIDENCE : produces
    INVESTIGATION ||--o{ RECEIPT : produces
    INVESTIGATION ||--o{ PROVENANCE : produces
    INVESTIGATION ||--o{ CORRELATION : produces
    INVESTIGATION ||--o{ FINDING : produces
    INVESTIGATION ||--o{ HYPOTHESIS : tracks
    INVESTIGATION ||--o{ TIMELINE : builds

    EXECUTION_CONTRACT {
        string ir_id PK
        string run_id PK
        json target
        json steps
        json policy
        json context
        datetime created_at
    }

    EVIDENCE {
        string id PK
        string run_id FK
        string step_id FK
        string collector
        string type
        string name
        string path
        int64 size
        string hash
        string hash_algo
        json metadata
        datetime collected_at
    }

    RECEIPT {
        string id PK
        string evidence_id UK FK
        string run_id FK
        string collector
        string collector_version
        string signature
        string public_key
        string payload_hash
        string payload_hash_algo
        datetime timestamp
        json host_info
    }

    PROVENANCE {
        string id PK
        string evidence_id FK
        string receipt_id FK
        string prev_provenance_id FK
        string action
        string actor
        string actor_version
        json input_hashes
        json output_hashes
        json parameters
        datetime timestamp
        string signature
    }

    CORRELATION {
        string id PK
        string run_id FK
        string src_evidence_id FK
        string dst_evidence_id FK
        string relation
        float confidence
        string method
        json details
        datetime created_at
        string created_by
    }

    FINDING {
        string id PK
        string run_id FK
        string rule_id
        string title
        string description
        string severity
        string status
        json evidence_ids
        json correlation_ids
        json tags
        json metadata
        datetime created_at
        datetime updated_at
    }

    HYPOTHESIS {
        string id PK
        string run_id FK
        string description
        json mitre_tags
        float confidence
        string status
        json supporting_evidence_ids
        json refuting_evidence_ids
    }

    TIMELINE {
        string id PK
        string run_id FK
        string name
        json evidence_ids
        datetime start_time
        datetime end_time
        json annotations
    }

    COLLECTOR_REGISTRY {
        string name PK
        string version
        json supported_actions
        json supported_os
        json capabilities
        json param_schemas
        json public_key
    }

    IR_MODULE {
        string id PK
        int version
        json metadata
        json steps
        json outputs
    }