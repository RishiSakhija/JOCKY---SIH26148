flowchart TD
    subgraph ANALYST["Analyst Workstation"]
        CLI["jockey CLI"]
        BROWSER["Browser\n(frontend dashboard)"]
    end

    subgraph SERVER["JOCKY Server (Single Binary)"]
        API["Axum HTTP Server\n:8080"]
        WS["WebSocket Server\n:8080/ws"]
        RUNTIME["Runtime Engine"]
        REGISTRY["Collector Registry"]
        STORAGE["SQLite DB\n(evidence, receipts, provenance,\ncorrelations, findings)"]
        FILES["Evidence Filesystem\n(evidence_root/)"]
    end

    subgraph TARGETS["Investigation Targets"]
        WIN_LIVE["Windows Live\n(proc_windows, file_windows,\nregistry_windows, logs_windows,\nnet_windows)"]
        LIN_LIVE["Linux Live\n(proc_linux, file_linux,\nconfig_linux, logs_linux,\nnet_linux)"]
        WIN_DEAD["Windows Disk Image\n(file_windows: MFT, USN, VSS)"]
        LIN_DEAD["Linux Disk Image\n(file_linux: ext4/xfs)"]
        MEM_DUMP["Memory Dump\n(Future: Volatility integration)"]
        NET_PCAP["Network Capture\n(Future: net_windows/net_linux capture)"]
    end

    subgraph EXTERNAL["External Integrations"]
        VEL["Velociraptor\n(VQL compilation target)"]
        KAPE["KAPE\n(targets compilation target)"]
        VOL["Volatility 3\n(plugin compilation target)"]
        OSQ["osquery\n(SQL compilation target)"]
        CASE["CASE/UCO\n(export format)"]
        TS["Timesketch\n(export format)"]
    end

    CLI -->|HTTPS/WS| API
    BROWSER -->|HTTPS/WS| API
    API --> RUNTIME
    WS --> RUNTIME
    RUNTIME --> REGISTRY
    RUNTIME --> STORAGE
    RUNTIME --> FILES
    REGISTRY -.->|Dynamic Load| WIN_LIVE
    REGISTRY -.->|Dynamic Load| LIN_LIVE
    RUNTIME -->|SSH/WinRM| WIN_LIVE
    RUNTIME -->|SSH| LIN_LIVE
    RUNTIME -->|Mount| WIN_DEAD
    RUNTIME -->|Mount| LIN_DEAD
    RUNTIME -.->|Future| MEM_DUMP
    RUNTIME -.->|Future| NET_PCAP
    RUNTIME -->|Compile| VEL
    RUNTIME -->|Compile| KAPE
    RUNTIME -->|Compile| VOL
    RUNTIME -->|Compile| OSQ
    EXPORT -.->|Export| CASE
    EXPORT -.->|Export| TS

