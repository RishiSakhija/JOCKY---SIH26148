flowchart TD
    subgraph COLLECT["Collection"]
        STEP["Execution Step\n(collector + action + params)"]
        COLLECTOR["Collector.execute()"]
        RAW["Raw Evidence Bytes\n+ Collector Metadata"]
    end

    subgraph HASH["Hashing"]
        BLAKE3["blake3(raw_bytes)\n→ payload_hash"]
    end

    subgraph RECEIPT["Receipt Generation"]
        SIGN["Ed25519_sign(payload_hash || evidence_id || timestamp, collector_privkey)"]
        RECEIPT_OBJ["EvidenceReceipt\n{id, evidence_id, run_id, collector, version,\n signature, public_key, payload_hash, timestamp, host_info}"]
    end

    subgraph EVIDENCE["Evidence Object Creation"]
        EVIDENCE_OBJ["Evidence\n{id, run_id, step_id, collector, type, name,\n path, size, hash, hash_algo, metadata, collected_at}"]
        WRITE["Write Evidence to Disk\n(evidence_root/run_id/evidence_id.jsonl)"]
    end

    subgraph PROVENANCE["Provenance Chain Initiation"]
        PROV_ROOT["ProvenanceRecord\n{id, evidence_id, receipt_id, prev=null,\n action='collected', actor=collector, actor_version,\n input_hashes=[], output_hashes=[payload_hash],\n timestamp, signature}"]
    end

    subgraph STORE["Persistence"]
        DB["SQLite\n(evidence, receipts, provenance tables)"]
        FS["Filesystem\n(evidence files)"]
    end

    STEP --> COLLECTOR
    COLLECTOR --> RAW
    RAW --> BLAKE3
    BLAKE3 --> SIGN
    SIGN --> RECEIPT_OBJ
    RAW --> EVIDENCE_OBJ
    EVIDENCE_OBJ --> WRITE
    WRITE --> FS
    RECEIPT_OBJ --> DB
    EVIDENCE_OBJ --> DB
    RECEIPT_OBJ --> PROV_ROOT
    PROV_ROOT --> DB

    style STEP fill:#8b5cf6,color:#fff
    style COLLECTOR fill:#8b5cf6,color:#fff
    style RAW fill:#3b82f6,color:#fff
    style BLAKE3 fill:#f59e0b,color:#fff
    style SIGN fill:#f59e0b,color:#fff
    style RECEIPT_OBJ fill:#f59e0b,color:#fff
    style EVIDENCE_OBJ fill:#f59e0b,color:#fff
    style WRITE fill:#f59e0b,color:#fff
    style PROV_ROOT fill:#ef4444,color:#fff
    style DB fill:#06b6d4,color:#fff
    style FS fill:#06b6d4,color:#fff