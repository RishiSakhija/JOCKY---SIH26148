erDiagram
    INVESTIGATION ||--o{ EVIDENCE_NODE : contains
    INVESTIGATION ||--o{ CORRELATION_EDGE : contains
    INVESTIGATION ||--o{ FINDING : produces
    INVESTIGATION ||--o{ HYPOTHESIS : tracks
    INVESTIGATION ||--o{ TIMELINE : builds

    EVIDENCE_NODE {
        string evidence_id PK
        string run_id FK
        string evidence_type
        datetime timestamp
        string summary
        json metadata
    }

    CORRELATION_EDGE {
        string id PK
        string run_id FK
        string src_evidence_id FK
        string dst_evidence_id FK
        string relation
        float confidence
        string method
        json details
        datetime created_at
        string created_by
    }

    FINDING {
        string id PK
        string run_id FK
        string rule_id
        string title
        string description
        string severity
        string status
        string[] evidence_ids
        string[] correlation_ids
        string[] tags
        json metadata
        datetime created_at
        datetime updated_at
    }

    HYPOTHESIS {
        string id PK
        string run_id FK
        string description
        string[] mitre_tags
        float confidence
        string status
        string[] supporting_evidence_ids
        string[] refuting_evidence_ids
    }

    TIMELINE {
        string id PK
        string run_id FK
        string name
        string[] evidence_ids
        datetime start_time
        datetime end_time
        json annotations
    }

    EVIDENCE_NODE ||--o{ CORRELATION_EDGE : "src"
    EVIDENCE_NODE ||--o{ CORRELATION_EDGE : "dst"
    FINDING }|--o{ EVIDENCE_NODE : "supported_by"
    HYPOTHESIS }|--o{ EVIDENCE_NODE : "supports"
    HYPOTHESIS }|--o{ FINDING : "validates"