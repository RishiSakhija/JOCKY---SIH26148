flowchart TD
    subgraph INPUT["Input"]
        SCRIPT["JOCKY Script\n(declarative, hypothesis-driven)"]
    end

    subgraph PARSE["Parsing (pest)"]
        LEXER["Lexer / Tokenizer"]
        PARSER["PEG Parser\n(grammar: docs/language/grammar.md)"]
        CST["Concrete Syntax Tree"]
    end

    subgraph AST["AST Construction"]
        AST_BUILD["AST Builder"]
        TYPED_AST["Typed AST\n+ Capability Inference"]
        DIAGS["Diagnostics\n(errors, warnings)"]
    end

    subgraph IR["IR Compilation"]
        LOWER["IR Lowering"]
        IR_MODULE["Forensic IR Module\n(platform-agnostic)"]
        IR_VALID["IR Validation\n(dependencies, cycles)"]
    end

    subgraph CONTRACT["Contract Building"]
        BIND["Bind IR to Target"]
        INJECT["Inject Policy\n(timeouts, parallelism, hash_algo)"]
        EXEC_CONTRACT["Execution Contract\n(run_id, target, steps, policy)"]
    end

    SCRIPT --> LEXER
    LEXER --> PARSER
    PARSER --> CST
    CST --> AST_BUILD
    AST_BUILD --> TYPED_AST
    AST_BUILD --> DIAGS
    TYPED_AST --> LOWER
    LOWER --> IR_MODULE
    IR_MODULE --> IR_VALID
    IR_VALID --> BIND
    BIND --> INJECT
    INJECT --> EXEC_CONTRACT

