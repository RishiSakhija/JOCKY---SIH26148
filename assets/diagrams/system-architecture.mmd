flowchart TD
    subgraph LANG["JOCKY Language Layer"]
        DSL["JOCKY Script (.jky)"]
        PEST["pest Parser"]
        AST["Typed AST"]
        IR["Forensic IR"]
    end

    subgraph CORE["JOCKY Core Layer"]
        CONTRACT["Execution Contract Builder"]
        POLICY["Policy Engine"]
        RUNTIME["Runtime Engine"]
    end

    subgraph COLLECTORS["Collector Layer"]
        REG["Collector Registry"]
        WIN["Windows Collectors"]
        LIN["Linux Collectors"]
        EBPF["eBPF Collectors (Future)"]
    end

    subgraph EVIDENCE["Evidence Layer"]
        MODEL["Common Evidence Model"]
        RECEIPT["Evidence Receipt (Ed25519)"]
        PROV["Provenance Chain"]
    end

    subgraph CORRELATION["Correlation Layer"]
        RULES["Deterministic Rules"]
        GRAPH["Investigation Graph (petgraph)"]
    end

    subgraph VERIFICATION["Verification Layer"]
        VERIFY["Verification Engine"]
    end

    subgraph EXPORT["Export Layer"]
        CASE["CASE/UCO JSON-LD"]
        CYTO["Cytoscape.js JSON"]
        TS["Timesketch CSV"]
        MD["Markdown Report"]
    end

    subgraph API["API Layer"]
        AXUM["Axum HTTP + WebSocket"]
        UI["Frontend Dashboard"]
    end

    DSL --> PEST
    PEST --> AST
    AST --> IR
    IR --> CONTRACT
    CONTRACT --> POLICY
    POLICY --> RUNTIME
    RUNTIME --> REG
    REG --> WIN
    REG --> LIN
    REG -.-> EBPF
    WIN --> MODEL
    LIN --> MODEL
    MODEL --> RECEIPT
    RECEIPT --> PROV
    PROV --> RULES
    RULES --> GRAPH
    GRAPH --> VERIFY
    VERIFY --> CASE
    VERIFY --> CYTO
    VERIFY --> TS
    VERIFY --> MD
    GRAPH --> AXUM
    AXUM --> UI

